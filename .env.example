# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# In the Coolify/Hetzner deployment the app and Postgres run in the same
# Compose stack, so the host is the service name "postgres" rather than a
# public DNS name. The password must be URL-encoded if it contains characters
# that are reserved in a URL.
DATABASE_URL=postgres://erp:change-me@postgres:5432/tailor_erp
POSTGRES_DB=tailor_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public site URL. Used to build password-reset and staff-invite links, and
# to return the customer to the right place after a Paddle checkout.
# Frontend and API are served from this same origin.
AUTH_BASE_URL=https://erp.example.com

# Optional: only needed if the frontend is ever served from a different origin
# than the API (not the case in the default single-origin deployment).
# Comma-separate multiple origins if set.
ALLOWED_ORIGIN=

NODE_ENV=production
PORT=3000

# Leave unset for a single-origin deployment (frontend and API share the same
# domain, so the client defaults to same-origin requests).
VITE_API_URL=

# ---------------------------------------------------------------------------
# Paddle billing  (see PADDLE_SETUP.md)
# ---------------------------------------------------------------------------
# Leave PADDLE_API_KEY, PADDLE_CLIENT_TOKEN and PADDLE_PRICE_ID unset to run
# with billing disabled: trials never expire and no checkout is offered. That
# is the right setting for local development and for a self-hosted single-shop
# deployment that is not sold as a subscription.
#
# "sandbox" uses Paddle's test environment; switch to "production" only once
# your Paddle account is approved for live payments. The sandbox and live
# environments have completely separate keys, products and prices.
PADDLE_ENVIRONMENT=sandbox

# Server-side API key (Paddle > Developer tools > Authentication).
# SECRET - never expose this to the browser and never commit it.
PADDLE_API_KEY=

# Client-side token (Paddle > Developer tools > Authentication > Client-side
# tokens). This one is published to the browser by design.
PADDLE_CLIENT_TOKEN=

# The recurring price your customers subscribe to
# (Paddle > Catalog > Products > your product > Prices). Starts with "pri_".
PADDLE_PRICE_ID=

# Signing secret of the webhook destination (Paddle > Developer tools >
# Notifications > your destination). SECRET. Without it every webhook is
# rejected, so subscriptions would never activate.
PADDLE_WEBHOOK_SECRET=

# Length of the self-serve free trial, in days, applied at signup.
BILLING_TRIAL_DAYS=14

# Days a shop keeps working after a renewal payment fails, while Paddle
# retries the card. Set to 0 to lock immediately on the first failure.
BILLING_GRACE_DAYS=7

# Fallback price shown on the public landing page when Paddle's localized
# price lookup is unavailable. Keep in step with the real price in Paddle.
BILLING_DISPLAY_PRICE=29
BILLING_DISPLAY_CURRENCY=USD

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------
# Optional: only needed if the staff-document storage proxy is used.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: structured log verbosity (default "info" in production, "debug" otherwise).
LOG_LEVEL=info

# Optional: error monitoring. Leave unset to disable Sentry entirely.
SENTRY_DSN=
