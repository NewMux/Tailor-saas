# PostgreSQL connection string for the self-hosted database on Hetzner.
# The password must be URL-encoded if it contains URL-reserved characters.
DATABASE_URL=postgres://erp:change-me@postgres:5432/tailor_erp
POSTGRES_DB=tailor_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# Email address automatically granted the admin role when it registers or signs in.
OWNER_EMAIL=owner@example.com

# Public Vercel URL used to build password-reset links, for example:
AUTH_BASE_URL=https://your-erp.vercel.app

# Exact Vercel origin(s) allowed to call the Hetzner API. Multiple origins may
# be comma-separated for production and a preview deployment.
ALLOWED_ORIGIN=https://your-erp.vercel.app

NODE_ENV=production
PORT=3000

# Vercel build-time variable for the public Hetzner API origin, for example:
VITE_API_URL=https://api.example.com

# Optional: only needed if the staff-document storage proxy is used.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
