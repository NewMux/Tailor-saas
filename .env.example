# PostgreSQL connection string. For local dev this points at the docker-compose
# postgres service. On Vercel it is the Supabase transaction-pooler string
# (project -> Connect -> Transaction pooler, port 6543) with ?sslmode=require;
# see DEPLOYMENT.md. The password must be URL-encoded if it contains
# URL-reserved characters.
DATABASE_URL=postgres://erp:change-me@postgres:5432/tailor_erp
# Vercel production builds only: Supabase session-pooler string (port 5432)
# that `pnpm run build:vercel` uses to apply migrations before deploying.
MIGRATION_DATABASE_URL=
POSTGRES_DB=tailor_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# Public site URL used to build password-reset, staff-invite and welcome
# links. Frontend and API are served from this same origin. Required in
# production.
AUTH_BASE_URL=https://erp.example.com

# Optional: only needed if the frontend is ever served from a different origin
# than the API (not the case in the default single-origin deployment).
# Comma-separate multiple origins if set.
ALLOWED_ORIGIN=

NODE_ENV=production
PORT=3000

# Leave unset for a single-origin deployment (frontend and API share the same
# domain, so the client defaults to same-origin requests).
VITE_API_URL=

# --- Transactional email (Resend) -------------------------------------------
# Password resets, staff invites and welcome emails. Set both or neither.
# Without them, reset links are written to the server log for an operator
# to hand over, and invite links must be copied and shared by the owner.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Tafsell <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# --- Subscription billing (Paddle) ------------------------------------------
# Set all four of PADDLE_API_KEY, PADDLE_CLIENT_TOKEN, PADDLE_PRICE_ID and
# PADDLE_WEBHOOK_SECRET to turn billing on, or leave all empty. While billing
# is off nobody is ever restricted and no billing UI is shown.
# PADDLE_ENV is "sandbox" (default, for testing) or "production".
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
# Length of the free trial new shops get at sign-up (default 14).
TRIAL_DAYS=14

# --- Private file storage (staff documents) ---------------------------------
# Any S3-compatible bucket; production uses Supabase Storage. Set all five or none.
# For Supabase: S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3,
# S3_REGION=<project region, e.g. ap-northeast-1>, S3_BUCKET=staff-documents,
# keys from Project Settings -> Storage -> S3 access keys.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Legacy alternative to S3_*: the Manus Forge storage proxy. Leave unset
# unless you are still on it.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: structured log verbosity (default "info" in production, "debug" otherwise).
LOG_LEVEL=info

# Optional: error monitoring. Leave unset to disable Sentry entirely.
SENTRY_DSN=
